{
  "name": "terrafracta",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build && node scripts/check_private_build_assets.mjs",
    "build:local-web": "TERRAFRACTA_LOCAL_STANDALONE=1 next build && node scripts/check_private_build_assets.mjs",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "errors:export": "node --experimental-strip-types scripts/export_error_log.mjs",
    "test:offline:node": "node --experimental-strip-types --test --test-isolation=none --test-concurrency=1 tests/*.test.mjs",
    "check:local": "python3 scripts/check_local.py",
    "rehearse:connected": "uv run --locked --no-sync python -m scripts.run_connected_fictional_update",
    "rehearse:source": "uv run --locked --no-sync python -m scripts.run_raw_transport_pair_trial",
    "rehearse:source:frozen": "uv run --locked --no-sync python -m scripts.run_frozen_raw_pair_trial",
    "rehearse:source:pinned-native": "uv run --locked --no-sync python -m scripts.check_pinned_raw_pair_native",
    "rehearse:source:private-wiring": "uv run --locked --no-sync python -m scripts.run_private_collector_wiring_trial",
    "rehearse:source:private-native": "uv run --locked --no-sync python -m scripts.check_private_ssb_capture_native",
    "rehearse:source:private-custodian": "uv run --locked --no-sync python -m scripts.run_private_custodian_trial",
    "rehearse:source:private-custodian-faults": "uv run --locked --no-sync python -m scripts.check_private_custodian_faults",
    "rehearse:source:private-recovery": "uv run --locked --offline --no-sync python -B -m scripts.check_private_attempt_recovery_native",
    "ssb:readiness": "uv run --locked --no-sync python -m scripts.check_private_attempt_readiness",
    "ssb:prepare-transport": "uv run --locked --no-sync python -m scripts.prepare_private_transport_source",
    "ssb:prepare-collector": "uv run --locked --no-sync python -m scripts.prepare_private_collector_source",
    "ssb:raw-audit": "uv run --locked python -m scripts.ssb_raw_db_reconcile",
    "oss:notice-bundle": "uv run --locked --offline --no-sync python -B -m scripts.prepare_server_notice_bundle",
    "prepare:local-web": "uv run --locked --offline --no-sync python -B -m scripts.prepare_local_web_candidate",
    "oss:inventory:check": "uv run --locked python scripts/oss_inventory.py --check",
    "oss:inventory:write": "uv run --locked python scripts/oss_inventory.py --write",
    "check:web": "pnpm build && node scripts/check_web_boundary.mjs"
  },
  "dependencies": {
    "next": "16.3.6",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  }
}
