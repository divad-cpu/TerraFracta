{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "instrumentation.ts",
    "instrumentation-client.ts",
    "src/server/postgres-issue-provider.ts",
    "src/server/postgres-work-proposal-transport.ts",
    "src/server/postgres-appended-capture-provider.ts",
    "src/server/appended-capture-selection.ts",
    "src/server/postgres-appended-work-transport.ts",
    "src/server/issue-preparation-context.ts",
    "src/server/empty-issue-preparation-context.ts",
    "src/server/initial-candidate-capture.ts",
    "src/server/pdf-initial-candidate-capture.ts",
    "src/server/pdf-appended-issue-review.ts",
    "src/server/pdf-appended-issue-capture.ts",
    "src/server/pdf-appended-capture-work.ts",
    "src/server/postgres-initial-candidate-work-transport.ts",
    "src/contact-free-correction-policy.ts",
    "src/invented-contact-free-custody.ts",
    "src/invented-contact-free-admission.ts",
    "src/invented-contact-free-recovery.ts",
    "src/invented-contact-free-address-identifiers.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "src/invented-contact-free-body-reader.ts",
    "src/invented-contact-free-preparation-trial.ts",
    "src/invented-contact-free-clock.ts",
    "src/contact-free-write-observation.ts",
    "src/invented-contact-free-write-trial.ts",
    "src/invented-contact-free-write-recovery.ts",
    "src/invented-contact-free-shared-inventory.ts",
    "src/invented-contact-free-shared-restore.ts",
    "src/invented-contact-free-body-ownership.ts",
    "src/invented-contact-free-body-handoff.ts",
    "src/invented-contact-free-shared-write-trial.ts",
    "src/server/html-appended-capture-work.ts",
    "src/server/postgres-html-appended-work-transport.ts",
    "src/server/html-appended-capture-reader.ts",
    "src/server/html-appended-capture-lookup.ts",
    "src/server/html-appended-capture-selection.ts",
    "src/server/postgres-html-appended-capture-provider.ts",
    "src/server/html-initial-candidate-capture.ts",
    "src/server/postgres-html-initial-candidate-work-transport.ts",
    "src/server/html-initial-candidate-lookup.ts",
    "src/server/html-initial-candidate-capture-selection.ts",
    "src/server/postgres-html-initial-candidate-capture-provider.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
